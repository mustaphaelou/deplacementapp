# Required environment variables.
#
# Production (Coolify): set each of these in the Coolify UI. The prod compose
# path (`npm run docker:prod`, i.e. docker-compose.yaml + compose.prod.yml)
# marks secrets required with ${VAR:?} and refuses to start without them, and
# the app itself refuses to boot in production with a missing, dev-only, or
# short BETTER_AUTH_SECRET. DATABASE_URL points at the Coolify-managed
# Postgres; BETTER_AUTH_URL is your public URL; SMTP_* is your mail relay.
#
# Development: copy this file to .env. `npm run docker:dev` merges
# docker-compose.yaml with compose.dev.yml, which supplies throwaway dev
# defaults (including the dev-only BETTER_AUTH_SECRET below) — never use that
# overlay, or these dev values, in production.

# Database — dev value matches the throwaway db service in compose.dev.yml
DATABASE_URL=postgresql://user:pass@localhost:5432/deplacementapp

# Dev-only: credentials for the throwaway db service in compose.dev.yml
POSTGRES_USER=user
POSTGRES_PASSWORD=pass
POSTGRES_DB=deplacementapp

# Auth (Better Auth — see ADR 0016)
# Prod: generate a fresh secret of at least 32 chars (e.g. `openssl rand -base64 32`).
# The value below is dev-only: production refuses to start with it.
BETTER_AUTH_SECRET=dev-only-secret-0123456789-abcdefghijklmnopqrstuvwxyz
# Public base URL for the app
BETTER_AUTH_URL=http://localhost:3000

# Google OAuth — create credentials at https://console.cloud.google.com/apis/credentials
# Required for "Sign in with Google" button on the login page
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# SMTP — dev values point at mailpit (compose.dev.yml); web UI on http://localhost:8025
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@exemple.ma
